# =============================================================================
# BESS Load Controller Dashboard — Environment configuration (self-hosted)
# =============================================================================
#
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# Generate JWT_SECRET with:
#   openssl rand -hex 32
#
# All secrets in this file are loaded by `dotenv` at server boot
# (see server/_core/index.ts).

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Database (MySQL 8) ─────────────────────────────────────────────────────
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://bess_user:CHANGE_ME@localhost:3306/bess_dashboard

# ─── Authentication ─────────────────────────────────────────────────────────
# HMAC secret used to sign session JWTs. Must be at least 32 hex chars.
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_-hex_32

# Set to "false" after the initial admin account has been created to disable
# self-service signup. The first user (when the database has 0 users) is
# always allowed and is automatically promoted to role=admin.
ALLOW_SIGNUP=true

# ─── FusionSolar Northbound API ─────────────────────────────────────────────
# Use the dedicated Northbound account (Sistema → Empresa → Northbound),
# NOT your portal user. The base URL depends on the region of your plant.
FUSIONSOLAR_BASE_URL=https://la5.fusionsolar.huawei.com/thirdData
FUSIONSOLAR_USERNAME=
FUSIONSOLAR_SYSTEM_CODE=

# ─── MQTT Broker (Mosquitto / Sonoff Tasmota) ───────────────────────────────
MQTT_BROKER_HOST=92.112.179.225
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ─── Notifications (Telegram Bot) — optional ────────────────────────────────
# Create a bot at @BotFather and grab the token. Get the chat id with
# https://api.telegram.org/bot<TOKEN>/getUpdates after sending /start to your
# bot. Leave both empty to disable notifications (alarms still get logged).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Storage — optional ─────────────────────────────────────────────────────
# Override where generated PDF reports are written. Defaults to ./storage-data
# relative to the working directory (typically /opt/bess-dashboard).
# STORAGE_DIR=/var/lib/bess-dashboard/storage
